# General Configuration
SUBTITLER_DEVICE=-1
SUBTITLER_LANGUAGE=en
SUBTITLER_THREADS=4
SUBTITLER_USE_GPU=true
SUBTITLER_FLASH_ATTN=false
SUBTITLER_UI=true

# VAD (Voice Activity Detection)
SUBTITLER_VAD_MODEL=models/silero_vad.onnx
SUBTITLER_VAD_THRESHOLD=0.5
SUBTITLER_VAD_ENERGY_THRESHOLD=0.05
SUBTITLER_VAD_SMOOTHING=0.2
SUBTITLER_VAD_HANGOVER=3
SUBTITLER_VAD_PREROLL=5
SUBTITLER_VAD_ADAPTIVE=true
SUBTITLER_VAD_ADAPTIVE_MIN=0.3
SUBTITLER_VAD_ADAPTIVE_MAX=0.8
SUBTITLER_VAD_ADAPTIVE_ALPHA=0.5

# STT (Speech-to-Text)
SUBTITLER_STT_MODEL=models/ggml-small.en.bin
SUBTITLER_STT_STEP=3000
SUBTITLER_STT_KEEP=200
SUBTITLER_STT_MAX_LENGTH=10000
SUBTITLER_STT_DEDUP=true
SUBTITLER_STT_MIN_REPETITION=5
SUBTITLER_STT_HALLUCINATION_LEN=2

# Logging
SUBTITLER_LOG_LEVEL=info
SUBTITLER_LOG_FILE=logs/subtitler.log
SUBTITLER_VERBOSE=false
